# Copy this file to `.env.local` for local development.
# Production non-sensitive values and resource bindings live in `wrangler.json`.
# Production secrets are uploaded with `wrangler secret put`.

DATABASE_URL=postgresql://user:password@localhost:5432/mydb
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://user:password@localhost:5432/database
OPENAI_API_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V4-Flash
RESEND_FROM=you@example.com
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
OPENAI_API_KEY=
